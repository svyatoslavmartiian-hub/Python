import random

# --- ФУНКЦІЇ ГРАФІКИ ---
def draw_hangman(attempts):
    """Повертає візуальний стан шибениці залежно від спроб"""
    stages = [
        """
           --------
           |      |
           |      O
           |     \\|/
           |      |
           |     / \\
           -""", # 0 спроб (програш)
        """
           --------
           |      |
           |      O
           |     \\|/
           |      |
           |     / 
           -""", # 1 спроба
        """
           --------
           |      |
           |      O
           |     \\|/
           |      |
           |      
           -""", # 2 спроби
        """
           --------
           |      |
           |      O
           |     \\|
           |      |
           |      
           -""", # 3 спроби
        """
           --------
           |      |
           |      O
           |      |
           |      |
           |      
           -""", # 4 спроби
        """
           --------
           |      |
           |      O
           |    
           |      
           |      
           -""", # 5 спроб
        """
           --------
           |      |
           |      
           |    
           |      
           |      
           -"""  # 6 спроб (початок)
    ]
    
    match attempts:
        case 0: return stages[0]
        case 1: return stages[1]
        case 2: return stages[2]
        case 3: return stages[3]
        case 4: return stages[4]
        case 5: return stages[5]
        case 6: return stages[6]
        case _: return "Помилка спроб"

# --- ФУНКЦІЇ РОБОТИ З ФАЙЛАМИ ---
def save_game_result(status, word):
    """Записує результат гри у файл history.txt (Пункт 6 вимог)"""
    try:
        with open("history.txt", "a", encoding="utf-8") as f:
            f.write(f"Результат: {status} | Слово: {word}\n")
    except Exception as e:
        print(f"Не вдалося зберегти історію: {e}")

# --- ОСНОВНА ЛОГІКА ГРИ ---
def play_game():
    """Запускає один раунд гри"""
    # Зчитування слів з файлу (Пункт 6 та 7: Обробка винятків)
    try:
        with open("words.txt", "r", encoding="utf-8") as f:
            words = f.read().splitlines()
        if not words:
            print("\n[!] Файл words.txt порожній. Додайте слова!")
            return
    except FileNotFoundError:
        print("\n[!] Помилка: Файл words.txt не знайдено поруч із програмою!")
        return

    # Ініціалізація змінних
    word_to_guess = random.choice(words).lower()
    guessed_letters = [] # Список для збереження введених літер (Пункт 4)
    attempts = 6

    print("\n" + "="*30)
    print("ГРА 'ШИБЕНИЦЯ' ПОЧАЛАСЯ")
    print("="*30)

    while attempts > 0:
        print(draw_hangman(attempts))
        
        # Формування рядка для відображення (Пункт 2: if-else)
        display = ""
        for letter in word_to_guess:
            if letter in guessed_letters:
                display += letter + " "
            else:
                display += "_ "
        
        print(f"Слово: {display}")
        print(f"Лишилося спроб: {attempts}")
        print(f"Ви вводили: {', '.join(guessed_letters)}")

        # Перевірка на перемогу
        if "_" not in display:
            print(f"\n[+] ВІТАЮ! Ви вгадали слово: {word_to_guess.upper()}")
            save_game_result("ПЕРЕМОГА", word_to_guess)
            break

        # Введення літери та валідація (Пункт 8 та 9)
        guess = input("\nВведіть літеру: ").lower()

        if len(guess) != 1 or not guess.isalpha():
            print(">>> Помилка: треба ввести ОДНУ літеру!")
            continue

        if guess in guessed_letters:
            print(">>> Ви вже вводили цю літеру!")
            continue

        guessed_letters.append(guess)

        # Перевірка, чи є літера в слові
        if guess not in word_to_guess:
            attempts -= 1
            print(">>> Немає такої літери!")
        else:
            print(">>> Є така літера!")

    if attempts == 0:
        print(draw_hangman(0))
        print(f"\n[!] ГРА ЗАКІНЧЕНА. Ви програли. Слово: {word_to_guess.upper()}")
        save_game_result("ПРОГРАШ", word_to_guess)

# --- ГОЛОВНЕ МЕНЮ (ТОЧКА ВХОДУ) ---
if __name__ == "__main__":
    while True:
        print("\n" + "*"*20)
        print("  ГОЛОВНЕ МЕНЮ")
        print("*"*20)
        print("1. Нова гра")
        print("2. Історія ігор")
        print("3. Вихід")
        
        user_choice = input("\nВаш вибір: ")
        
        if user_choice == "1":
            play_game()
        elif user_choice == "2":
            try:
                print("\n--- ВАША ІСТОРІЯ ---")
                with open("history.txt", "r", encoding="utf-8") as f:
                    print(f.read())
            except FileNotFoundError:
                print("\nІсторія поки що порожня.")
        elif user_choice == "3":
            print("\nУспіхів у навчанні! Бувай.")
            break
        else:
            print("\n[!] Оберіть пункт 1, 2 або 3.")